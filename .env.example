# ==============================================================================
# Environment Configuration Template for Country Analytics
# Copy this file to .env and configure your environment-specific values.
# NEVER commit real credentials or .env into version control.
# ==============================================================================

# REST Countries API Configuration
REST_COUNTRIES_API_KEY=your_rest_countries_api_key_here

# PostgreSQL Database Configuration
POSTGRES_USER=airflow
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=country_analytics
POSTGRES_PORT=5432

# Apache Airflow Configuration (Targeting Python 3.12 runtime)
AIRFLOW_IMAGE_NAME=country-analytics-airflow:2.9.3-python3.12
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
AIRFLOW_WEBSERVER_PORT=8081
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=your_secure_airflow_admin_password_here
_AIRFLOW_WWW_USER_EMAIL=admin@example.com
_AIRFLOW_WWW_USER_FIRSTNAME=Airflow
_AIRFLOW_WWW_USER_LASTNAME=Admin

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_secure_pgadmin_password_here
PGADMIN_PORT=5050

# Metabase Configuration
METABASE_PORT=3000
